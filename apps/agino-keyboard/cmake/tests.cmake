  set(layer_server_header ${CMAKE_CURRENT_BINARY_DIR}/wayland/layer-shell-server.h)
  add_custom_command(OUTPUT ${layer_server_header}
   COMMAND Wayland::Scanner server-header ${layer_protocol} ${layer_server_header}
   DEPENDS ${layer_protocol} Wayland::Scanner)
  add_executable(test-shelllifecycle tests/test_shelllifecycle.cpp ${layer_server_header}
   ${CMAKE_CURRENT_BINARY_DIR}/wayland/wayland-wlr-layer-shell-unstable-v1-protocol.c
   ${CMAKE_CURRENT_BINARY_DIR}/wayland/xdg-shell-protocol.c)
  add_dependencies(test-shelllifecycle agino-keyboard-shell)
  target_include_directories(test-shelllifecycle PRIVATE ${CMAKE_CURRENT_BINARY_DIR}/wayland)
  target_link_libraries(test-shelllifecycle PRIVATE desktop-adapter Qt6::Test Qt6::Gui PkgConfig::WAYLAND_SERVER)
  add_test(NAME keyboard-wayland-shell-lifecycle COMMAND test-shelllifecycle)
  set_tests_properties(keyboard-wayland-shell-lifecycle PROPERTIES TIMEOUT 20 ENVIRONMENT "QT_PLUGIN_PATH=${CMAKE_BINARY_DIR}/plugins")
